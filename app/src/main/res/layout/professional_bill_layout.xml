<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/pdf_section_border"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/shop_logo_imageview"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:visibility="visible"
            tools:src="@drawable/ic_launcher_foreground" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/shop_name_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="YOUR SHOP NAME"
                android:textColor="#1E2761"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shop_tagline_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/pdf_header_strip_bg"
                android:gravity="center"
                android:padding="4dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Manufacturing &amp; Supply of Precision Tools" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/shop_meta_line1_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="start"
        android:textColor="#222222"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="Plot No A64, Road No 21, Wagle Industrial Estate" />

    <TextView
        android:id="@+id/shop_meta_line2_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="start"
        android:textColor="#222222"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="Phone: 9876543210 | GSTIN: 27ABCDE1234F1Z5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/pdf_section_border"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/shop_gstin_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GST NO: NA"
            android:textColor="#111111"
            android:textSize="7sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bill_title_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tax_invoice"
            android:textColor="#111111"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="ORIGINAL FOR RECIPIENT"
            android:textColor="#111111"
            android:textSize="8sp"
            android:maxLines="2"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/pdf_section_border"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.05"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Customer Detail"
                android:textColor="#111111"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/customer_name_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#111111"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="2"
                tools:text="M/S Shiv Engineering" />

            <TextView
                android:id="@+id/customer_phone_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#111111"
                android:textSize="10sp"
                tools:text="Phone: 9878789878" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#1F1F1F" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.95"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Invoice No."
                    android:textColor="#111111"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/invoice_no_value_textview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="INV-0001"
                    android:textColor="#111111"
                    android:textSize="11sp"
                    android:textAlignment="viewStart"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Invoice Date"
                    android:textColor="#111111"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bill_date_textview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="#111111"
                    android:textSize="10sp"
                    android:maxLines="2"
                    tools:text="23-Jul-2025" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/pdf_section_border"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EFEFEF"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No"
                android:textColor="#111111"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="6dp"
                android:text="Name of Product / Service"
                android:textColor="#111111"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Qty"
                android:textColor="#111111"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="Weight"
                android:textColor="#111111"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bill_extra_details_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/pdf_section_border"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/payment_summary_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#111111"
            android:textSize="11sp"
            tools:text="Billed: Rs 5000.00 | Paid: Rs 2000.00 | Debt: Rs 3000.00" />

        <TextView
            android:id="@+id/debt_due_date_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#111111"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Debt Due: 2026-04-07"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/return_item_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#111111"
            android:textSize="11sp"
            tools:text="Return Item: Gold 1.250 g | Deduction: Rs 500.00" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/pdf_section_border"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Subtotal"
                android:textColor="#111111"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtotal_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#111111"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Rs 3,805.00" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gst_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/gst_label_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#111111"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="GST (18.00%)" />

            <TextView
                android:id="@+id/gst_amount_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#111111"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Rs 684.90" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="#1F1F1F" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total"
                android:textColor="#101010"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/total_amount_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#101010"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Rs 4,490.00" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>