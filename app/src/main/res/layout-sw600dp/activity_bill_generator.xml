<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jewells_surface"
    android:orientation="vertical"
    tools:context=".fragments.GenerateBillFragment">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bill_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:clipToPadding="false">

            <!-- Header Card (Top Full Width) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/header_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/jewells_navy"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New Invoice"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
                        android:textColor="@color/white"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Complete the details below to generate a professional bill."
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textColor="#B0C4DE" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Left Column: Customer & Payment -->
            <LinearLayout
                android:id="@+id/left_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintTop_toBottomOf="@id/header_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/right_column">

                <!-- Customer Section -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Jewells.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Customer Details"
                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold" />
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:hint="@string/customerName"
                            app:startIconDrawable="@drawable/ic_empty_items">
                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/name_editText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:completionThreshold="1"
                                android:inputType="textPersonName|textCapWords" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="Phone Number"
                            app:startIconDrawable="@drawable/ic_phone">
                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/phone_editText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:completionThreshold="1"
                                android:inputType="phone" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/customer_lookup_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:padding="12dp"
                            android:background="@drawable/pdf_header_strip_bg"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:visibility="gone" />

                        <HorizontalScrollView
                            android:id="@+id/recent_customers_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:scrollbars="none">
                            <LinearLayout
                                android:id="@+id/recent_customers_container"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="Village / City"
                            app:startIconDrawable="@drawable/ic_location">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/village_editText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPostalAddress|textCapWords" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Payment Section -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Jewells.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Payment &amp; Returns"
                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold" />
                        <RadioGroup
                            android:id="@+id/payment_mode_radio_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">
                            <RadioButton
                                android:id="@+id/cash_radio_button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cash Payment"
                                android:checked="true" />
                            <RadioButton
                                android:id="@+id/online_radio_button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:text="Online / UPI" />
                        </RadioGroup>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/return_item_switch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Include Old metal return"
                            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
                        <LinearLayout
                            android:id="@+id/return_item_details_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Return Metal Type"
                                android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

                            <RadioGroup
                                android:id="@+id/return_item_type_radio_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">
                                <RadioButton
                                    android:id="@+id/return_gold_radio"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Gold"
                                    android:checked="true" />
                                <RadioButton
                                    android:id="@+id/return_silver_radio"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:text="Silver" />
                                <RadioButton
                                    android:id="@+id/return_other_radio"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:text="Other" />
                            </RadioGroup>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="horizontal">
                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="Wt (g)">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/return_item_weight_editText"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="numberDecimal" />
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.2"
                                    android:layout_marginStart="16dp"
                                    android:hint="Deduct ₹">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/return_item_deduct_amount_editText"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="numberDecimal" />
                                </com.google.android.material.textfield.TextInputLayout>
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/add_return_item_button"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Add Return to Bill"
                                app:icon="@drawable/ic_add" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/return_items_recycler_view"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                tools:listitem="@layout/selected_item_layout" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Right Column: Items & Summary -->
            <LinearLayout
                android:id="@+id/right_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:layout_marginStart="12dp"
                app:layout_constraintTop_toBottomOf="@id/header_card"
                app:layout_constraintStart_toEndOf="@id/left_column"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Items Section -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Jewells.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Items Purchased"
                                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                                android:textColor="?attr/colorPrimary"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/item_actions"/>
                            <LinearLayout
                                android:id="@+id/item_actions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent">
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_scan_barcode"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Scan"
                                    app:icon="@drawable/ic_camera"/>
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/add_button_new_item"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:text="Add Item"
                                    app:icon="@drawable/ic_add"/>
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/item_recycler_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:minHeight="200dp"
                            tools:listitem="@layout/selected_item_layout" />
                        <include
                            android:id="@+id/generate_bill_items_empty"
                            layout="@layout/view_empty_state" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Totals Section -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Jewells.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/jewells_gold_container"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/gst_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Include GST"
                                android:textColor="@color/jewells_on_gold_container"
                                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/gst_percentage_layout"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="32dp"
                                android:hint="GST %"
                                android:visibility="gone"
                                tools:visibility="visible">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/gst_percentage_editText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:hint="Final Bill Total (₹)"
                            app:hintTextColor="@color/jewells_on_gold_container"
                            app:boxStrokeColor="@color/jewells_on_gold_container">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/manual_total_editText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
                                android:textColor="@color/jewells_on_gold_container"
                                android:textStyle="bold" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Guaranteed Non-Overlapping Bottom Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/generate_button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="16dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/jewells_surface">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/generate_bill_button"
            android:layout_width="450dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:text="Review &amp; Finalize Bill"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="@color/white"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_receipt"
            app:iconPadding="12dp"
            app:backgroundTint="?attr/colorSecondary" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>